{
  "version": 1,
  "scan": {
    "intervalMinutes": 15,
    "timezone": "Asia/Kuala_Lumpur"
  },
  "dataSource": {
    "failoverEndpoints": [
      {
        "name": "binance-futures",
        "market": "futures",
        "base": "https://fapi.binance.com/fapi/v1"
      },
      {
        "name": "binance-futures-mirror",
        "market": "futures",
        "base": "https://www.binance.com/fapi/v1"
      },
      {
        "name": "binance-spot-vision",
        "market": "spot",
        "base": "https://data-api.binance.vision/api/v3"
      },
      {
        "name": "bybit-linear",
        "market": "futures",
        "dialect": "bybit",
        "root": "https://api.bybit.com",
        "base": "https://api.bybit.com"
      }
    ],
    "_failoverDoc": "The first three hops are all Binance-owned hostnames: when Binance geo-blocks a runner (HTTP 451) they fail together, which is one source with three spellings rather than redundancy. bybit-linear is a different company on different infrastructure with its own geo policy, translated into the Binance response shape by scanner/market_data.py so nothing downstream changes. Its USDT perpetual universe overlaps Binance's closely but is NOT identical -- the venue that served each scan is recorded in system-status.lastScan.apiStats.endpointUsed, and prices/funding are that venue's, not Binance's.",
    "requestTimeoutSeconds": 12,
    "maxRetries": 3,
    "retryBackoffSeconds": 1.5,
    "maxRequestsPerScan": 700,
    "klineLimits": {
      "4h": 260,
      "1h": 300,
      "15m": 500,
      "1d": 230
    }
  },
  "universe": {
    "maxSymbols": 100,
    "minQuoteVolume24h": 3000000,
    "excludeSymbolPatterns": [
      "UPUSDT",
      "DOWNUSDT",
      "BULLUSDT",
      "BEARUSDT"
    ],
    "excludeBaseAssets": [
      "USDC",
      "FDUSD",
      "TUSD",
      "DAI",
      "BUSD",
      "USDP",
      "AEUR",
      "EUR",
      "PAXG"
    ],
    "minListingAgeDays": 30
  },
  "indicators": {
    "emaFast": 20,
    "emaMid": 50,
    "emaSlow": 200,
    "rsiPeriod": 14,
    "adxPeriod": 14,
    "atrPeriod": 14,
    "relVolumeLookback": 20,
    "vwapWindow": 48
  },
  "structure": {
    "swingLookback": 2,
    "minSwingAgeBars": 3,
    "sweepMaxAtrMultiple": 1.0,
    "displacementBodyAtrMultiple": 1.5,
    "equalLevelAtrTolerance": 0.1,
    "maxStructureSwings": 40
  },
  "smc": {
    "fvgMinGapAtrMultiple": 0.1,
    "obLookback": 10,
    "setupWindowBars": 12
  },
  "signalModel": {
    "rsiLongMin": 45,
    "rsiLongMax": 74,
    "rsiShortMin": 26,
    "rsiShortMax": 55,
    "minAdx15m": 15,
    "minRelVolume": 1.2,
    "minAtrPercent": 0.1,
    "maxAtrPercent": 3.0
  },
  "risk": {
    "minRr": 2.5,
    "preferredRr": 3.0,
    "stopBufferAtrMultiple": 0.5,
    "triggerBufferAtrMultiple": 0.1,
    "entryZoneAtrMultiple": 0.5,
    "maxStopAtrMultiple": 3.5,
    "maxRunupAtrMultiple": 3.5,
    "minStructureRoomAtrMultiple": 1.0,
    "minStopAtrMultiple": 0.15
  },
  "costs": {
    "enabled": true,
    "entryFeePct": 0.05,
    "exitFeePct": 0.05,
    "useFunding": true,
    "fundingIntervalMs": 28800000,
    "maxCostR": 0.25,
    "_doc": "Binance USD-M VIP0 taker 0.05%/side; entry and exit are stop orders so both are taker. maxCostR rejects any setup whose round-trip cost exceeds that fraction of 1R -- a risk budget smaller than the cost of taking it cannot be won. Per-signal cost is reported as costR with the net figure in rMultipleNet; costs are NEVER netted into rMultiple silently."
  },
  "scoring": {
    "minScore": 80,
    "aPlusThreshold": 90,
    "aThreshold": 85,
    "bPlusThreshold": 80,
    "weights": {
      "htfAlignment": 20,
      "marketStructure": 20,
      "liquiditySmc": 20,
      "momentum": 15,
      "volume": 10,
      "volatility": 5,
      "riskReward": 10
    }
  },
  "lifecycle": {
    "triggerExpiryCandles": 12,
    "tradeExpiryCandles": 16,
    "resolveAmbiguousWith1m": true,
    "candleMs": 900000
  },
  "dedupe": {
    "symbolCooldownMinutes": 240,
    "sameDirectionOnly": true,
    "maxActiveSignalsTotal": 12
  },
  "retention": {
    "marketSnapshots": 288,
    "logEntries": 200
  },
  "performance": {
    "monteCarloBlockLength": null,
    "_doc": "null = automatic moving-block length round(n^(1/3)), capped at n//2. Blocks (not single trades) are resampled so correlated losing streaks survive; an independent shuffle understates maxDDp95. Set an integer to override."
  },
  "sessions": {
    "killZones": [
      {
        "name": "ASIA",
        "startUtcHour": 0,
        "endUtcHour": 6
      },
      {
        "name": "LONDON",
        "startUtcHour": 7,
        "endUtcHour": 10
      },
      {
        "name": "NEW_YORK",
        "startUtcHour": 12,
        "endUtcHour": 15
      }
    ]
  },
  "derivatives": {
    "enabled": true,
    "oiTopSymbols": 20,
    "fundingExtremePct": 0.05,
    "hardFilter": false,
    "_doc": "fundingRatePct = predicted rate per 8h in percent (0.01 = 0.01%/8h). Context & display only when hardFilter=false; never alters the 100-point score."
  },
  "bias1d": {
    "enabled": true,
    "requireAlignment": false,
    "_doc": "1D macro bias is fetched, stored and displayed. requireAlignment=true would hard-reject signals against a strong 1D bias (OFF by default to preserve current behaviour)."
  }
}
